{
  "name": "nz-gst-invoicer",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack invoicing app for NZ freelancers: Next.js, TypeScript, Supabase, GST 15%",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
